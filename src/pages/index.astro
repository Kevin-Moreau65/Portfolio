---
import { locales } from "astro:schema";
import geti18nContent from "../i18n/get-content";
import Layout from "../layouts/Layout.astro";
import face from "../assets/goat.png";
import { Image } from "astro:assets";

const locale = geti18nContent.page("index", Astro.url);
---

<Layout
  ><div class="w-full h-full flex items-start justify-center">
    <div class="max-w-7xl w-9/10 md:w-3/4 island p-4">
      <div class="w-full profile-card">
        <h1
          style="grid-area: title;"
          class="text-center font-title text-5xl font-bold"
        >
          Kévin Moreau
        </h1>
        <div
          class="w-full island aspect-3/4 flex items-center justify-center bg-gray-50 overflow-hidden relative group"
          style="grid-area: picture;"
        >
          <Image
            src={face}
            alt={locale.alts.face}
            style="transition: scale 2s, filter 0.2s;"
            class="w-full h-full grayscale-100 group-hover:grayscale-0 group-hover:scale-105 ease-in-out"
          />
          <div
            class="absolute w-full h-full bg-light-blue/30 group-hover:opacity-0 duration-200"
          >
          </div>
        </div>
        <p style="grid-area: quotation;" class="quotation font-semibold">
          {locale.quotation}
        </p>
        <div style="grid-area: tags;" class="flex felx-col flex-wrap gap-2">
          <div class="tag purple">{locale.tags.devFullstack}</div>
          <div class="tag blue">{locale.tags.devops}</div>
          <div class="tag red">{locale.tags.techEntusiast}</div>
        </div>
        <h2
          style="grid-area: description-title;"
          class="font-title text-3xl font-bold"
        >
          {locale.titles.whoAmI}
        </h2>
        <p style="grid-area: description-content;">
          {locale.description}
        </p>
      </div>
    </div>
  </div>
</Layout>

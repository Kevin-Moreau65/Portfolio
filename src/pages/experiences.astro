---
import Experience from "../components/Experience.astro";
import geti18nContent from "../i18n/get-content";
import Layout from "../layouts/Layout.astro";

const locale = geti18nContent.page("experiences", Astro.url);
---

<Layout
  ><div class="flex w-full flex-col gap-4">
    <section class="flex flex-col gap-2">
      <h1 class="font-title text-center md:text-7xl text-5xl font-bold">
        {locale.title}
      </h1>
      <div class="island overflow-hidden p-2 md:text-base text-xs">
        <span
          class="bg-black rounded-xl text-white font-semibold pt-0.5 pl-1 pr-1 pb-0.5 md:pt-1 md:pl-2 md:pr-2 md:pb-1"
          >{locale.tldr.title}</span
        >
        {locale.tldr.content}
      </div>
    </section>
    <Experience {...locale.bac3} />
    <Experience {...locale.bac5} />
    <Experience {...locale.now} />
  </div></Layout
>

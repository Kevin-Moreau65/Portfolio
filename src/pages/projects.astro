---
import Button from "../components/Button.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="pl-4 pr-4 grid grid-cols-5 w-full gap-4">
    {
      new Array(30).fill(undefined).map(() => (
        <div class="w-full bg-white island grid grid-rows-[auto_auto_1fr_1fr] divide-y-2 overflow-hidden aspect-3/4">
          <div class="pt-2 pl-2">
            <p class="font-title font-semibold text-lg">Project 1</p>
          </div>
          <div class="bg-gray-400 w-full aspect-video" />
          <div>
            <p class="text-sm p-2">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Etiam et
              orci sed nulla sollicitudin fringilla. Ut ante eros, dignissim a.
            </p>
          </div>
          <div class="flex flex-row justify-evenly items-center p-2">
            <Button content="Access" icon="External" />
            <Button content="Source code" icon="Code" />
          </div>
        </div>
      ))
    }
  </div>
</Layout>

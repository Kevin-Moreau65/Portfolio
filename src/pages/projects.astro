---
import Button from "../components/Button.astro";
import geti18nContent from "../i18n/get-content";
import Layout from "../layouts/Layout.astro";
const locale = geti18nContent.page("projects", Astro.url);

const projects = Object.values(locale.projects);
---

<Layout>
  <div
    class="grid grid-flow-row grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-4"
  >
    {
      projects.map((project) => (
        <div class="w-full bg-white island grid group grid-rows-[auto_auto_1fr_1fr] divide-y-2 duration-150 overflow-hidden aspect-3/4 hover:-translate-1.5 hover:shadow-[12px_12px_5px_0px_rgba(0,0,0,0.3)]">
          <div class="pt-2 pl-2">
            <p class="font-title font-semibold text-lg">{project.name}</p>
          </div>
          <div class=" w-full aspect-video overflow-hidden">
            <img
              src={project.picture}
              alt=""
              srcset=""
              class="w-full h-full group-hover:scale-110 duration-1000"
            />
          </div>
          <div>
            <p class="text-sm p-2">{project.description}</p>
          </div>
          <div class="flex flex-row justify-evenly items-center p-2">
            {project.access !== "" && (
              <a href={project.access} target="_blank">
                <Button content="Access" icon="External" />
              </a>
            )}
            <a href={project.sourceCode} target="_blank">
              <Button content="Source code" icon="Code" />
            </a>
          </div>
        </div>
      ))
    }
  </div>
</Layout>

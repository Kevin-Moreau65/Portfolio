---
import Header from "../components/Header.astro";
import customGetLocale from "../i18n/get-locale";
import "../styles/global.css";
const localeLanguage = customGetLocale(Astro.url);
---

<!doctype html>
<html lang={localeLanguage}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Kévin Moreau</title>
  </head>
  <body
    class="grid grid-rows-[auto_1fr] h-full bg-light-blue max-h-full overflow-hidden"
  >
    <Header />
    <div class="flex justify-center pt-4 w-full overflow-auto">
      <div class="pl-4 pr-4 w-full max-w-360">
        <slot />
      </div>
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>

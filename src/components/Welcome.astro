---
import customGetLocale from "../i18n/get-locale";
import Layout from "../layouts/Layout.astro";

const locale = customGetLocale(Astro.url);

let title: string;
switch (locale) {
  case "fr":
    title = "Bonjour Monde!";
    break;
  default:
    title = "Hello World!";
}
---

<Layout title={title}>
  <h1>{title}</h1>
</Layout>

---
interface Props {
  title: string;
  infos: string;
  tags: { title: string; color: string }[];
  content: string;
}
const { title, content, infos, tags } = Astro.props;
---

<section class="flex flex-col gap-1.5">
  <div class="flex flex-row items-end gap-1">
    <h2 class="font-title text-5xl">{title}</h2>
    <h3 class="font-title text-lg italic">
      {infos}
    </h3>
  </div>
  <div class="flex flex-row gap-2 flex-wrap">
    {tags.map((t) => <div class="tag">{t.title}</div>)}
  </div>
  <div>
    <p>
      {content}
    </p>
  </div>
</section>

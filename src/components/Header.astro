---
import geti18nContent from "../i18n/get-content";
import Button from "./Button.astro";
import customGetLocale from "../i18n/get-locale";
import type { LocaleKeys } from "../i18n/config/locales";
import { defaultLocale } from "../i18n/config/locales";
const locale = geti18nContent.component("header", Astro.url);
const localeKey = customGetLocale(Astro.url);
const languages = [
  {
    value: "fr",
    key: "Français",
  },
  {
    value: "en",
    key: "English",
  },
] satisfies { value: LocaleKeys; key: string }[];
const getLanguageUrl = (languageKey: LocaleKeys) => {
  const languageUrl = new URL(Astro.url);
  const currentLocaleKey = customGetLocale(Astro.url);
  const paths = languageUrl.pathname.split("/").filter((s) => s !== "");
  const isLocaleKeyDefault = languageKey === defaultLocale;
  const isCurrentLocaleDefault = currentLocaleKey === defaultLocale;
  const isIndexPage = paths[0] === "index.html";
  if (isCurrentLocaleDefault && !isLocaleKeyDefault) {
    if (paths.length === 0) {
      paths.push(`${languageKey}.html`);
    } else if (isIndexPage) {
      paths[0] = `${languageKey}.html`;
    } else {
      paths.unshift(languageKey);
    }
  }
  if (isLocaleKeyDefault && !isCurrentLocaleDefault) {
    paths.shift();
  }
  languageUrl.pathname = paths.join("/");
  return languageUrl;
};
---

<nav class="w-full h-min flex justify-center pt-2 pb-2 pr-4 pl-4">
  <ul
    class="flex flex-row gap-2 p-2 items-center bg-header rounded-2xl border-4 shadow-[8px_8px_0px_0px_rgba(0,0,0,0.5)] w-full max-w-450"
  >
    <li>
      <a href={locale.home.href}>
        <Button
          content={locale.home.text}
          active={!Astro.url.pathname.endsWith(".html") ||
            Astro.url.pathname.endsWith(locale.home.href)}
        />
      </a>
    </li>
    <li>
      <a href={locale.projects.href}>
        <Button
          content={locale.projects.text}
          active={Astro.url.pathname.endsWith("projects.html")}
        /></a
      >
    </li>
    <li>
      <a href="/experiences.html">
        <Button
          content="Experiences"
          active={Astro.url.pathname.endsWith("experiences.html")}
        />
      </a>
    </li>
    <li class="ml-auto">
      <select
        class="island rounded-2xl cursor-pointer p-1.5"
        onchange="location.href = this.value;"
      >
        {
          languages.map((language) => {
            return (
              <option
                value={getLanguageUrl(language.value).pathname}
                selected={localeKey === language.value}
              >
                {language.key}
              </option>
            );
          })
        }
      </select>
    </li>
  </ul>
</nav>

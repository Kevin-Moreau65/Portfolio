---
import Icon, { Icons } from "./Icon.astro";
interface Props {
  content: string;
  active?: boolean;
  icon?: keyof typeof Icons;
}
const { content, active = false, icon } = Astro.props;
const buildClassName = () => {
  let className = ["button flex flex-row items-center gap-2"];
  if (active) className.push("active");
  return className.join(" ");
};
---

<button class={buildClassName()}>
  {
    icon !== undefined && (
      <div class="h-4 aspect-square">
        <Icon name={icon} />
      </div>
    )
  }
  {content}
</button>
